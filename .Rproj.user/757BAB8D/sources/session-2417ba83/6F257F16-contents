/* Dégradé général rose/gris */
.reveal {
  background: linear-gradient(160deg, #fce4ec, #f8bbd0, #f1f1f1);
  font-family: "Segoe UI", Roboto, Helvetica, sans-serif;
  color: #333;
}

/* Titres */
.reveal h1, .reveal h2, .reveal h3 {
  color: #d81b60;
  text-shadow: 0 1px 3px rgba(0,0,0,0.12);
}

/* Encadrés */
.reveal blockquote {
  border-left: 4px solid #f06292;
  background: rgba(255, 240, 246, 0.7);
  padding: 0.5em 1em;
}

/* Listes */
.reveal ul li {
  margin-bottom: 0.4em;
}

/* Liens */
.reveal a {
  color: #ad1457;
}
.reveal a:hover {
  color: #f06292;
}

/* Logo */
.reveal .slide-logo {
  background-color: transparent !important;
  border-radius: 50%;
  box-shadow: 0 0 8px rgba(0,0,0,0.10);
}
